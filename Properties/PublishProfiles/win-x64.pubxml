<?xml version="1.0" encoding="utf-8"?>
<!--
  发布配置：生成"免安装、免运行库"的单文件 exe。
  用法：dotnet publish -p:PublishProfile=win-x64
  产物：publish\win-x64\SerialAssistant.exe（约 59 MB，内含 .NET 运行时）

  注意：WPF 不支持 NativeAOT，也不支持 PublishTrimmed（会裁掉 XAML 需要的反射信息），
  所以体积只能靠 EnableCompressionInSingleFile 压到 59 MB，这是下限。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>

    <PublishDir>publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
