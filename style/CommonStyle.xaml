<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════
         调色板：取自哆啦A梦 —— 身体蓝、脸白、鼻子红、铃铛黄
         品牌色只用于点缀与关键动作，大面积交给低饱和中性色
         ══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DoraemonBlue"      Color="#0B93D5"/>
    <SolidColorBrush x:Key="DoraemonBlueDeep"  Color="#0577B0"/>
    <SolidColorBrush x:Key="DoraemonBlueSoft"  Color="#EAF5FC"/>
    <SolidColorBrush x:Key="DoraemonRed"       Color="#E4453A"/>
    <SolidColorBrush x:Key="BellYellow"        Color="#F7B733"/>
    <SolidColorBrush x:Key="SuccessGreen"      Color="#3BA55D"/>
    <SolidColorBrush x:Key="SuccessSoft"       Color="#E9F6ED"/>
    <SolidColorBrush x:Key="SuccessLine"       Color="#BFE3CC"/>

    <SolidColorBrush x:Key="Ink"        Color="#1D2B38"/>
    <SolidColorBrush x:Key="InkMuted"   Color="#65798B"/>
    <SolidColorBrush x:Key="InkFaint"   Color="#96A6B5"/>
    <SolidColorBrush x:Key="Surface"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Canvas"     Color="#F2F7FC"/>
    <SolidColorBrush x:Key="Line"       Color="#E2EBF3"/>
    <SolidColorBrush x:Key="LineStrong" Color="#C9DCEC"/>
    <SolidColorBrush x:Key="FieldBg"    Color="#FAFCFE"/>

    <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F9FCFE" Offset="0"/>
        <GradientStop Color="#EDF3FA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AA9E6" Offset="0"/>
        <GradientStop Color="#0A86C6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2AB4EE" Offset="0"/>
        <GradientStop Color="#0B93D5" Offset="1"/>
    </LinearGradientBrush>

    <!-- 统一的键盘焦点环，替代默认虚线框 -->
    <Style x:Key="ControlFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" Opacity="0.55"
                            BorderBrush="{StaticResource DoraemonBlue}" BorderThickness="1.5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         哆啦A梦头像（矢量，可任意缩放复用）
         ══════════════════════════════════════════════════════════ -->
    <DrawingImage x:Key="DoraemonFace">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 头 -->
                <GeometryDrawing Brush="#0B93D5">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="50,50" RadiusX="47" RadiusY="45"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 脸 -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="50,52" RadiusX="37" RadiusY="34"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 胡须 -->
                <GeometryDrawing Geometry="M26,50 L5,43 M26,57 L5,57 M26,64 L5,71 M74,50 L95,43 M74,57 L95,57 M74,64 L95,71">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#22303C" Thickness="2.6" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- 眼睛 -->
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="40,31" RadiusX="10" RadiusY="12"/>
                            <EllipseGeometry Center="60,31" RadiusX="10" RadiusY="12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#22303C" Thickness="2"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- 瞳孔 -->
                <GeometryDrawing Brush="#22303C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="44,32" RadiusX="3.4" RadiusY="4.2"/>
                            <EllipseGeometry Center="56,32" RadiusX="3.4" RadiusY="4.2"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 鼻子 -->
                <GeometryDrawing Brush="#E4453A">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="50,49" RadiusX="6.6" RadiusY="6.6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="47.7,46.7" RadiusX="2.1" RadiusY="1.9"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- 嘴 -->
                <GeometryDrawing Geometry="M50,56 L50,62 M36,64 Q50,76 64,64">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#22303C" Thickness="2.2" StartLineCap="Round" EndLineCap="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 铃铛：小尺寸下依然可辨识，用于状态栏 -->
    <DrawingImage x:Key="BellIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#E0A800">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="50,13" RadiusX="5" RadiusY="5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F7B733" Geometry="M50,18 C33,18 24,34 24,53 L24,64 L76,64 L76,53 C76,34 67,18 50,18 Z"/>
                <GeometryDrawing Brush="#E0A800" Geometry="M23,63 L77,63 A5,5 0 0 1 77,73 L23,73 A5,5 0 0 1 23,63 Z"/>
                <GeometryDrawing Brush="#E0A800">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="50,81" RadiusX="6" RadiusY="6"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ══════════════════════════════════════════════════════════
         基础排版与容器
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource WindowBackground}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- 卡片：极浅描边 + 一层向下扩散的柔影，制造浮起感 -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,17"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#12314B" Opacity="0.05" BlurRadius="22"
                                  ShadowDepth="3" Direction="270"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 标题前的小蓝条 -->
    <Style x:Key="SectionMark" TargetType="Border">
        <Setter Property="Width" Value="3"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Background" Value="{StaticResource DoraemonBlue}"/>
        <Setter Property="Margin" Value="0,0,9,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         按钮：悬停换色、按下调暗，红色「断开」态也有独立悬停色
         ══════════════════════════════════════════════════════════ -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="78"/>
        <Setter Property="Padding" Value="17,0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Shade" CornerRadius="10" Background="#0B2233"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shade" Property="Opacity" Value="0.13"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="#F0F5F9"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line}"/>
                            <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮：默认样式 -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryGradientHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 次要按钮：白底描边，悬停转浅蓝 -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DoraemonBlueSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                <Setter Property="Foreground" Value="{StaticResource DoraemonBlueDeep}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 日志开关：圆点 + 文字。未开启白底灰点，开启后浅绿底绿点，直观呈现写入状态 -->
    <Style x:Key="LogToggleButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="106"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                                     Margin="0,0,7,0" Fill="{StaticResource InkFaint}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsLogSaving}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SuccessSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SuccessLine}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessGreen}"/>
                            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                        </DataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 连接按钮：未连接为蓝，已连接转为红 -->
    <Style x:Key="ConnectButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
        <Setter Property="MinWidth" Value="112"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryGradientHover}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsOpenPort}" Value="True">
                <Setter Property="Background" Value="{StaticResource DoraemonRed}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsOpenPort}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#D63C31"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         复选框：胶囊标签
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" CornerRadius="14" Padding="12,6"
                            Background="Transparent"
                            BorderBrush="{StaticResource Line}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center"
                                     Margin="0,0,7,0" Fill="{StaticResource InkFaint}"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldBg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DoraemonBlueSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DoraemonBlue}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DoraemonBlue}"/>
                            <Setter Property="Foreground" Value="{StaticResource DoraemonBlueDeep}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         下拉框
         ══════════════════════════════════════════════════════════ -->
    <Style x:Key="SoftComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DoraemonBlueSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DoraemonBlueSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource DoraemonBlueDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource FieldBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisual}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="10"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="1"
                                            SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"
                                              Data="M0,0 L4.5,4.5 L9,0"
                                              Stroke="{StaticResource InkMuted}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DoraemonBlue}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DoraemonBlue}"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="6"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource Surface}" CornerRadius="12"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}" Padding="5">
                                <Border.Effect>
                                    <DropShadowEffect Color="#12314B" Opacity="0.13" BlurRadius="20"
                                                      ShadowDepth="4" Direction="270"/>
                                </Border.Effect>
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         输入框（圆角由外层 Border 提供，这里只统一配色）
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource DoraemonBlue}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource DoraemonBlue}"/>
        <Setter Property="SelectionOpacity" Value="0.22"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         滚动条：细窄、无箭头，轨道透明
         ══════════════════════════════════════════════════════════ -->
    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#C6D6E4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#A8BED2"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#93AEC6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ScrollBarRepeatButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                              Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                              Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                                      Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarRepeatButton}"
                                                      Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
